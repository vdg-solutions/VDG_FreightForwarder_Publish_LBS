// kernel-module contract — client-js-root (frontend/js).
kernel-module a architecture-module; path "js/implementations/kernel".
kernel-module responsibility own-pure-helpers-i18n-and-version.
kernel-module public-boundary-dtos <AG_GRID_LOCALE_KEYS APP_VERSION DUE_SOON_TIER FX_PAIR_DEFAULT MANAGER_SENTINEL NEXT_ON_PATH SAFE_AWAIT_DEFAULT_MS SHIPMENT_MAIN_PATH SHIPMENT_OFF_PATH SHIPMENT_STATES SafeAwaitTimeoutError UNKNOWN_STATE>.
kernel-module public-ports <bindAppEvents bindBase64 bindClock bindHttp bindKeyValueStore bindLog bindTimer bindVisibility b64Decode b64Encode dispatchAppEvent fetchJson fetchText isPageVisible keyValueStore kvGet kvRemove kvSet logWarn nowDate nowMs dateFrom onVisibilityChange startInterval startTimer stopInterval stopTimer>.
kernel-module public-entry-functions <addRateEntry agGridLocaleText boundedList buildDistribution clearRateCache consumeReloadGuard currentLocale dimLabel drillDimValueLabel fmtDate fmtNumber formatDrillDimDesc getRateForDate guardMessage isDevHost kindI18nLabel loadLocale parseJsonlBundle phaseIndex rearmReloadGuard renderMasterLoadRetryRow renderMasterLoadRetryStatus resolveDueSoonTier resolveSalesRepLabel resolveShipmentState safeAwait safeMasterLoad serializeJsonlBundle shipmentLane shouldPromptUpdate statusBadgeLabel t toLocalDateStr todayLocal visibleDeadline>.
kernel-module emitted-core-events <>.
kernel-module accepted-core-events <>.
kernel-module dependency-allowlist <>.
