// kernel-module contract — client-js-root (frontend/js).
kernel-module a architecture-module; path "js/implementations/kernel".
kernel-module responsibility own-pure-helpers-i18n-and-version.
kernel-module public-boundary-dtos <AG_GRID_LOCALE_KEYS APP_VERSION DUE_SOON_TIER FX_PAIR_DEFAULT MANAGER_SENTINEL NEXT_ON_PATH PAYMENT_DUE_WARN_DAYS SAFE_AWAIT_DEFAULT_MS SHIPMENT_MAIN_PATH SHIPMENT_OFF_PATH SHIPMENT_STATES SafeAwaitTimeoutError UNKNOWN_STATE>.
kernel-module public-ports <>.
kernel-module public-entry-functions <addRateEntry agGridLocaleText boundedList boundedSeedIfEmpty buildDistribution checkCodeUnique checkIataUnique checkScacUnique checkUldCodeUnique clearRateCache consumeReloadGuard currentLocale dimLabel drillDimValueLabel emailPrefix fmtDate fmtNumber formatDrillDimDesc genUnitId getRateForDate guardMessage hasCheckedToday isDevHost kindI18nLabel loadLocale markCheckedToday parseJsonlBundle phaseIndex rearmReloadGuard renderMasterLoadRetryRow renderMasterLoadRetryStatus resolveDueSoonTier resolveSalesRepLabel resolveShipmentState safeAwait safeMasterLoad serializeJsonlBundle shipmentLane shouldPromptUpdate statusBadgeLabel t toLocalDateStr todayLocal validateAirlineCarrier validateAirlineIata validateAirlineIcao validateAirportIata validateAirportIcao validateFlightNo validateOceanCarrier validateRate validateScac validateUldCode validateUnit visibleDeadline>.
kernel-module emitted-core-events <>.
kernel-module accepted-core-events <>.
kernel-module dependency-allowlist <>.
