// storage-module contract — client-js-root (frontend/js).
storage-module a architecture-module; path "js/implementations/storage".
storage-module responsibility own-the-storage-authority-port-and-its-adapters.
storage-module public-boundary-dtos <ApiError KIND_PATH_OVERRIDES LOG_KINDS LS_CURRENT_WORKSPACE_KEY LS_WORKSPACES_KEY TOKEN_KEY WorkspaceRegistry>.
storage-module public-ports <ACCESS_TOKEN_ISSUED_KEY ANCHOR_EVT_POPUP_BLOCKED ANCHOR_EVT_SIGNIN_REQUIRED EntityRepo IDENTITY_SCOPE LedgerRepo PROFILE_KEY ROLE_CACHE_KEY RoleUndeterminedError SERVER_SESSION_TTL_MS SharedIoPort UserRepoPort VERDICT_GRANT VERDICT_MANAGER VERDICT_NOT_PROVISIONED _resetBackend _resetBackendPort _resetEventBus _resetIdentityProvider _resetLedgerRepo _resetLocalStore _resetOAuthProvider _resetPopupGuard _resetProfileCache _resetServerSession _resetTokenAnchorFactory _resetTokenAuthority _resetWorkspaceAuthority apiFetch bindBackend bindEventBus bindIdentityProvider bindLedgerRepo bindLocalStore bindOAuthProvider bindPopupGuard bindProfileCache bindServerSession bindTokenAnchorFactory bindTokenAuthority bindWorkspaceAuthority createTokenAnchor detectBackend dispatchAppEvent ensureWindowOpen getAccessToken getCurrentUser hydrateSessionFromToken initGoogleSignIn isNativeOpen ledgerRepo localStore readCachedProfile rebuildSessionFromStoredToken reconnectInteractive recoverFromUnauthorized refreshAccessTokenSilently renderSignInButton restampIdTokenExp serverSessionIdentity setStoreScope signOut sqlCountEntities wasPreviouslySignedIn workspaceAuthority writeCachedProfile>.
storage-module public-entry-functions <API_BASE WORKSPACE_NAME activeWorkspaceName buildUser encodeSyntheticIdToken parseIdToken toPricedEnvelope>.
storage-module emitted-core-events <>.
storage-module accepted-core-events <>.
storage-module dependency-allowlist <kernel-module>.
