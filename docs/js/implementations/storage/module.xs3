// storage-module contract — client-js-root (frontend/js).
storage-module a architecture-module; path "js/implementations/storage".
storage-module responsibility own-the-storage-authority-port-and-its-adapters.
storage-module public-boundary-dtos <ApiError CREATED_FOLDER_TTL_MS ConcurrencyError FOLDER_MIME GRANTS_DIR GRANT_AREAS_KEY GRANT_FILE_TAG KIND_PATH_OVERRIDES LOG_KINDS LS_CURRENT_WORKSPACE_KEY LS_WORKSPACES_KEY TOKEN_KEY USERS_PATH WorkspaceRegistry>.
storage-module public-ports <ACCESS_TOKEN_ISSUED_KEY ANCHOR_EVT_POPUP_BLOCKED ANCHOR_EVT_SIGNIN_REQUIRED EntityRepo IDENTITY_SCOPE LedgerRepo PROFILE_KEY ROLE_CACHE_KEY RoleUndeterminedError SERVER_SESSION_TTL_MS SharedIoPort UserRepoPort VERDICT_FORK VERDICT_GRANT VERDICT_MANAGER VERDICT_NOT_PROVISIONED _resetBackend _resetBackendPort _resetBundleHealer _resetEventBus _resetFileDedup _resetFolderDedup _resetFolderResolver _resetGrantReader _resetIdentityProvider _resetLedgerRepo _resetLocalStore _resetManifestRefresh _resetOAuthProvider _resetPopupGuard _resetProfileCache _resetServerSession _resetStorageApi _resetTokenAnchorFactory _resetTokenAuthority _resetWorkspaceAuthority apiFetch bindBackend bindBundleHealer bindEventBus bindFileDedup bindFolderDedup bindFolderResolver bindGrantReader bindIdentityProvider bindLedgerRepo bindLocalStore bindOAuthProvider bindPopupGuard bindProfileCache bindServerSession bindStorageApi bindTokenAnchorFactory bindTokenAuthority bindWorkspaceAuthority createTokenAnchor detectBackend dispatchAppEvent ensureWindowOpen findSharedFilesByNamePrefix getAccessToken getCurrentUser getFile healDuplicateBundle hydrateSessionFromToken initGoogleSignIn isNativeOpen ledgerRepo localStore mergeBundleContents readCachedProfile readGrant rebuildSessionFromStoredToken reconnectInteractive recoverFromUnauthorized refreshAccessTokenSilently renderSignInButton restampIdTokenExp serverSessionIdentity setStoreScope signOut sqlCountEntities storageApi wasPreviouslySignedIn workspaceAuthority writeCachedProfile>.
storage-module public-entry-functions <API_BASE WORKSPACE_NAME activeWorkspaceName buildUser clearFolderMemo clearGrantAreas encodeSyntheticIdToken forgetFolder forkFromGrantName grantFileName grantSearchKey parseGrant parseGrantAreas parseIdToken recallFolder recallGrantAreas rememberFolder rememberGrantAreas toPricedEnvelope>.
storage-module emitted-core-events <>.
storage-module accepted-core-events <>.
storage-module dependency-allowlist <kernel-module>.
